pe": "feedback"}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "id": 0, "correct": 1, "selected": 0}], "_data": [{"type": "question", "contents": [{"content": "engenn6le15ob08re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " \nLet's talk about visiting famous buildings!", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Reading", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Great Places to Visit", "type": "lesson_name"}, {"content": "The Taj Mahal", "type": "unit_name"}, {"content": 8, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 15, "type": "lesson"}, {"content": "B1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe routines and regular activities in a wider range of social and work contexts.", "type": "primary"}, {"content": "Writes short texts using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level.", "type": "secondary_1"}, {"content": "Writes short texts using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level. Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_2"}, {"content": "Writes short texts using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level. Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_3"}, {"content": "Writes short texts using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level. Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_4"}, {"content": "Writes short texts using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level. Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_5"}, {"content": "Writes short texts using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level. Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_6"}, {"content": "Writes short texts using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level. Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_7"}, {"content": "Writes short texts using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level. Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "Writing About Famous Buildings and Structures", "type": "heading"}, {"content": "When writing about famous buildings and structures, it is important to describe the building and give some information about it.", "type": "describer"}, {"content": "You use adjectives like <span class=\"italic\">majestic</span>, <span class=\"italic\">impressive</span> and <span class=\"italic\">special</span> to describe a famous building.", "type": "text"}, {"content": "You include facts like:  <ul><li>who built it</li> <li>when it was built</li> <li>why it was built</li> <li>where it is</li> <li>how many people helped build it</li></ul>", "type": "text"}, {"content": "You can also include information about the architecture and surrounding areas (gardens, pools etc.).", "type": "text"}, {"content": "The Taj Mahal was built in 22 years.", "type": "example"}, {"content": "Every year the Colosseum in Rome is visited by millions of people. ", "type": "example"}, {"content": "The passive voice can be used to express information about a building or structure that experiences an action rather than the person or object that performs the action. The most important thing becomes the subject of the sentence.", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": "Would Rather for What Is Preferable", "type": "heading"}, {"content": "You can use the expression <span class=\"strong italic\">would rather</span> as an alternative to the verb <span class=\"italic\">prefer</span>. You express your preference when there are two items of choice.", "type": "describer"}, {"content": "Example:<br/> <ul><li><span class=\"italic product-color-text\"><span class=\"strong\">John</span>: Would you like to visit the Great Wall of China or the Taj Mahal?<br/> <span class=\"strong\">Sandra</span>: I <span class=\"strong\">would rather</span> visit the Taj Mahal.<br/> <span class=\"strong\">John</span>: I <span class=\"strong\">would rather</span> see the Taj Mahal myself (than see it in pictures).</span></li></ul>", "type": "text"}, {"content": "You usually use the contracted form of the expression, <span class=\"strong italic\">'d rather</span>. ", "type": "text"}, {"content": "<ul><li><span class=\"italic product-color-text\">I<span class=\"strong\">'d rather</span> visit the Taj Mahal.</span></li> <li><span class=\"italic product-color-text\">I<span class=\"strong\">'d rather</span> see the Great Wall of China.</span> </li></ul>", "type": "text"}, {"content": "You use the expression <span class=\"strong italic\">'d rather</span> followed by the basic form of the verb.", "type": "text"}, {"content": "<ul><li><span class=\"italic product-color-text\">He<span class=\"strong\">'d rather</span> write about a Modern World Wonder.</span></li> <li><span class=\"italic product-color-text\">We<span class=\"strong\">'d rather</span> take pictures at night.</span></li></ul>", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "marble ", "type": "name"}, {"content": "a hard stone used in sculpture and architecture ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The Taj Mahal is made of marble.", "type": "example"}, {"content": "engenn6le15ob08aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to write about buildings.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "tomb ", "type": "name"}, {"content": "a large burial chamber (for the dead) ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The Taj Mahal is a tomb.", "type": "example"}, {"content": "engenn6le15ob08aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "kingdom ", "type": "name"}, {"content": "a territory ruled by a king or a queen ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The Taj Mahal was built in the center of the kingdom.", "type": "example"}, {"content": "engenn6le15ob08aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "garden ", "type": "name"}, {"content": "an area of land used for growing flowers ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The building is located in a formal garden.", "type": "example"}, {"content": "engenn6le15ob08aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "dome ", "type": "name"}, {"content": "a large, round roof ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The famous white dome shines in the sunlight.", "type": "example"}, {"content": "engenn6le15ob08aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "pool ", "type": "name"}, {"content": "an area of water ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There are four long pools of water around the Taj Mahal.", "type": "example"}, {"content": "engenn6le15ob08aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "symmetry", "type": "name"}, {"content": "the quality of having exactly the same parts facing each other ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There is symmetry in the lines of the Taj Mahal.", "type": "example"}, {"content": "engenn6le15ob08aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "geometric ", "type": "name"}, {"content": " decorated with regular lines and shapes", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: There are geometric shapes, plants and flowers around the Taj Mahal.", "type": "example"}, {"content": "engenn6le15ob08aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "majestic ", "type": "name"}, {"content": "impressive; spectacular", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I've never seen a more majestic structure.", "type": "example"}, {"content": "engenn6le15ob08aud10", "type": "audio"}]}, {"content": "engenn6le15ob08re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Think of 6 famous buildings or structures.", "type": "text"}, {"content": "Write down their names on small pieces of paper.", "type": "text"}, {"content": "Your partner will do the same.", "type": "text"}, {"content": "Choose two random pieces of paper and ask your partner which one they would rather go to.", "type": "text"}, {"content": "Ask them follow-up questions to keep the conversation going.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write down the names of 6 famous buildings or structures.", "type": "text"}, {"content": "I choose two buildings and ask my partner which ones they would rather visit.", "type": "text"}, {"content": "I ask follow-up questions to keep the conversation going.", "type": "text"}]}]}