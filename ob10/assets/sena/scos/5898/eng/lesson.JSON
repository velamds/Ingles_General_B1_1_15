tent": "How", "type": "text"}], "selected": 0}]}, {"_data": [{"type": "question", "contents": [{"content": "How  ", "type": "text"}]}, {"type": "incorrect", "contents": [{"content": "could", "type": "text"}]}, {"type": "post_question", "contents": {"content": "does Montreal become in the winter?", "type": ""}}, {"content": "secondary_2", "type": "objective"}], "id": 4, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "cold", "type": "text"}], "selected": 0}]}]}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "id": 0, "template_override": 1}, {"id": 1, "contents": [{"value": {"audiosrc": "engenn6le15ob10re2aud01", "images": [{"image": "engenn6le15ob10re2img01.jpg", "id": 0, "text": "", "time": "0"}, {"image": "engenn6le15ob10re2img01.jpg", "id": 1, "text": "Have you ever experienced the excitement of a live performance? How breathtaking is it to feel the emotions of a jazz solo? Where else would you rather be?", "time": "100"}, {"image": "engenn6le15ob10re2img02.jpg", "id": 2, "text": "I took the day to walk around the Festival. First, I watched some of the free shows. There were probably two million people on the streets.   I heard a mixture of sounds, from experimental jazz to conventional blues music. The caf\u00e9s were filled with activity. People were dancing happily in the streets. Then I continued along to Parc Musical, where joyful children were running around.\nHow idyllic was that moment? In a few months Montreal will once again become a cold, snowy winter city. I would rather enjoy the summer while it lasts! I would rather celebrate music and life in unison with an entire city!", "time": "8500"}, {"image": "engenn6le15ob10re2img03.jpg", "id": 3, "text": "If you are a jazz lover like me, you owe it to yourself to visit the Festival at least once in your life. I'd rather warn you though: you might want to come back every year after that!", "time": "46000"}], "coverimg": "engenn6le15ob10re2img01.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}], "id": 0, "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}]}